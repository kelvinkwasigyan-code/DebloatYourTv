<?xml version="1.0" encoding="utf-8"?>
<!-- Hebrew-only header positioning. Other languages use layout/activity_main.xml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Time-of-day backdrop, drawn once a minute (config.xml sky_intensity; 0 keeps it hidden).
         Keep in step with layout/activity_main.xml: every view there must exist here too. -->
    <com.gathin.tvhome.SkyView
        android:id="@+id/sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- Cinematic top shelf (cinematic_home): the focused dock app's artwork, a few pixels across and
         stretched over the screen, which softens it like a blur without the cost of one. Hidden otherwise. -->
    <ImageView
        android:id="@+id/heroArt"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:alpha="0"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <!-- Ambient glow in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Nova Video Player movie backdrop slideshow layer (mirrored for RTL) -->
    <FrameLayout
        android:id="@+id/movieSlideshowLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:visibility="gone"
        android:importantForAccessibility="no">

        <ImageView
            android:id="@+id/movieBackdropA"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/movieBackdropB"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:alpha="0"
            android:importantForAccessibility="no" />

        <!-- Cinematic gradient scrim for contrast and text readability -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/movie_scrim"
            android:importantForAccessibility="no" />

        <!-- Movie recommendation info kicker -->
        <LinearLayout
            android:id="@+id/movieInfoContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|right"
            android:layout_marginEnd="68dp"
            android:layout_marginTop="158dp"
            android:gravity="right"
            android:orientation="vertical"
            android:importantForAccessibility="no">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/movieRecommendationBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@string/font_medium"
                    android:letterSpacing="0.18"
                    android:singleLine="true"
                    android:textColor="#FFD54F"
                    android:textSize="12sp" />

                <View
                    android:layout_width="3dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="8dp"
                    android:background="#FFD54F" />
            </LinearLayout>

            <TextView
                android:id="@+id/movieTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@string/font_regular"
                android:includeFontPadding="false"
                android:letterSpacing="-0.01"
                android:shadowColor="#D9000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="10"
                android:singleLine="true"
                android:textColor="#FFFFFFFF"
                android:textSize="32sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Race-weekend panel (a theme's race_calendar, see RaceWeekend), mirrored: under the clock on the right. -->
    <LinearLayout
        android:id="@+id/racePanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|right"
        android:layout_marginEnd="60dp"
        android:layout_marginTop="158dp"
        android:gravity="right"
        android:orientation="vertical"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/raceKicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.22"
                android:textAllCaps="true" />

            <View
                android:layout_width="3dp"
                android:layout_height="13dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/race_bar" />
        </LinearLayout>

        <TextView
            android:id="@+id/raceHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp"
            android:fontFamily="@string/font_light"
            android:letterSpacing="-0.01"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/raceSessions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:singleLine="true"
            android:textColor="#99FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="0.12" />
    </LinearLayout>

    <!-- Cinematic top shelf: darkens the edge behind the shelf and the lower half, so the text and the
         dock stay readable over the artwork. -->
    <View
        android:id="@+id/heroScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <!-- Top shelf: the focused dock app's name, positioned above the dock in code. -->
    <LinearLayout
        android:id="@+id/hero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="68dp"
        android:layout_gravity="right"
        android:gravity="right"
        android:orientation="vertical"
        android:alpha="0">

        <TextView
            android:id="@+id/heroName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:gravity="right"
            android:textColor="#FFFFFFFF"
            android:textSize="48sp"
            android:fontFamily="@string/font_light"
            android:letterSpacing="-0.02"
            android:includeFontPadding="false"
            android:singleLine="true" />

        <!-- Cinematic shelf only: when the app was last opened, and the dock position dots. -->
        <TextView
            android:id="@+id/heroMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:layout_marginEnd="4dp"
            android:layout_marginTop="12dp"
            android:singleLine="true"
            android:textColor="#B3FFFFFF"
            android:textSize="15sp"
            android:fontFamily="@string/font_light"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/heroDots"
            android:layout_width="wrap_content"
            android:layout_height="6dp"
            android:layout_gravity="right"
            android:layout_marginEnd="4dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="26dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- No clipping down to the pills: with advanced effects a focused pill scales up past its row. -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_toEndOf="@+id/topButtons"
                android:layout_marginStart="16dp"
                android:orientation="horizontal"
                android:gravity="right|bottom">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="9dp"
                    android:orientation="vertical">

                    <!-- Shamsi date ("27 Mehr 1405"), shown when shamsi_date is on. -->
                    <TextView
                        android:id="@+id/shamsiDate"
                        android:gravity="right"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textColor="#E6FFFFFF"
                        android:textSize="17sp"
                        android:fontFamily="@string/font_regular"
                        android:letterSpacing="0.02"
                        android:includeFontPadding="false"
                        android:visibility="gone" />

                    <TextClock
                        android:id="@+id/date"
                        android:gravity="right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:format12Hour="@string/date_format"
                        android:format24Hour="@string/date_format"
                        android:textColor="#A6FFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="@string/font_regular"
                        android:letterSpacing="0.14"
                        android:textAllCaps="true" />

                        <!-- Lunar date ("Lunar 13/9 · Year of the Horse"), shown when lunar_date is on. -->
                        <TextView
                            android:id="@+id/lunarDate"
                            android:gravity="right"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textColor="#80FFFFFF"
                            android:textSize="14sp"
                            android:fontFamily="@string/font_regular"
                            android:letterSpacing="0.14"
                            android:textAllCaps="true"
                            android:visibility="gone" />
                </LinearLayout>

                <View
                    android:id="@+id/clockDivider"
                    android:layout_width="1dp"
                    android:layout_height="26dp"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="8dp"
                    android:background="#33FFFFFF" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/greeting"
                        android:gravity="center_horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="9sp"
                        android:autoSizeMaxTextSize="12sp"
                        android:autoSizeStepGranularity="1sp"
                        android:ellipsize="end"
                        android:textColor="#8CFFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="@string/font_medium"
                        android:letterSpacing="0"
                        android:textAllCaps="true" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="true">
                        <TextClock
                            android:id="@+id/ampm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:singleLine="true"
                            android:textDirection="rtl"
                            android:layout_gravity="bottom"
                            android:layout_marginBottom="8dp"
                            android:format12Hour="a"
                            android:format24Hour=""
                            android:textColor="#B3FFFFFF"
                            android:textSize="15sp"
                            android:fontFamily="@string/font_medium"
                            android:letterSpacing="0"
                            android:ellipsize="none"
                            android:textAllCaps="true" />

                        <TextClock
                            android:id="@+id/clock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:format12Hour="h:mm"
                            android:format24Hour="HH:mm"
                            android:textColor="#FFFFFFFF"
                            android:textSize="52sp"
                            android:fontFamily="@string/font_light"
                            android:letterSpacing="-0.04"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

            <!-- Shown only when show_stats is on. Outside leftBlock, so the top buttons stay level with the clock
                 row; gone, it takes no space. -->
            <TextView
                android:id="@+id/stats"
                android:layout_width="wrap_content"
                android:layout_below="@id/leftBlock"
                android:layout_alignStart="@id/leftBlock"
                android:layout_alignEnd="@id/leftBlock"
                android:gravity="right"
                android:textDirection="rtl"
                android:layout_marginEnd="6dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#D9FFFFFF"
                android:textSize="14sp"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.04"
                android:focusable="false"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignBottom="@id/leftBlock"
                android:layout_marginBottom="6dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/btnProfile"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="10dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/profile_circle_bg"
                    android:focusable="true"
                    android:clickable="true"
                    android:contentDescription="@string/google_account"
                    android:nextFocusDown="@+id/grid">

                    <ImageView
                        android:id="@+id/profileAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/profile_avatar" />

                    <TextView
                        android:id="@+id/profileInitial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:background="@drawable/profile_initial_bg"
                        android:textColor="#FFFFFFFF"
                        android:textSize="20sp"
                        android:fontFamily="@string/font_medium"
                        android:text="K"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/btnSettings"
                    style="@style/TopButton"
                    android:text="@string/settings"
                    android:drawableStart="@drawable/ic_settings"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnLibraryTop"
                    style="@style/TopButtonIcon"
                    android:visibility="gone"
                    android:contentDescription="@string/app_library"
                    android:drawableStart="@drawable/ic_apps"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnReorder"
                    style="@style/TopButtonIcon"
                    android:contentDescription="@string/reorder"
                    android:drawableStart="@drawable/ic_swap_vert"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnVpn"
                    style="@style/TopButton"
                    android:visibility="gone"
                    android:singleLine="true"
                    android:text="@string/vpn"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopButton"
                    android:maxWidth="180dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/wifi"
                    android:drawableStart="@drawable/ic_wifi"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopButton"
                    android:text="@string/inputs"
                    android:drawableStart="@drawable/ic_input"
                    android:nextFocusDown="@+id/grid" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nowPlayingPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_below="@+id/topButtons"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/now_playing_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/nowPlayingInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="@drawable/now_playing_info_bg"
                    android:paddingStart="6dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <com.gathin.tvhome.EqualizerView
                        android:id="@+id/nowPlayingEqualizer"
                        android:layout_width="16dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="9dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:duplicateParentState="true">

                        <TextView
                            android:id="@+id/nowPlayingTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="170dp"
                            android:singleLine="true"
                            android:ellipsize="marquee"
                            android:marqueeRepeatLimit="marquee_forever"
                            android:scrollHorizontally="true"
                            android:textColor="@drawable/pill_text"
                            android:duplicateParentState="true"
                            android:textSize="13sp"
                            android:fontFamily="@string/font_medium"
                            android:letterSpacing="0.01" />

                        <TextView
                            android:id="@+id/nowPlayingArtist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="170dp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textColor="@drawable/pill_text_dim"
                            android:duplicateParentState="true"
                            android:textSize="11sp"
                            android:fontFamily="@string/font_regular" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="8dp"
                    android:background="#2EFFFFFF" />

                <ImageView
                    android:id="@+id/btnNowPrev"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="7dp"
                    android:src="@drawable/ic_skip_previous"
                    android:tint="@drawable/pill_text"
                    android:background="@drawable/media_button_bg"
                    android:focusable="true"
                    android:clickable="true"
                    android:contentDescription="@string/previous" />

                <ImageView
                    android:id="@+id/btnNowPlayPause"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_play"
                    android:tint="@drawable/pill_text"
                    android:background="@drawable/media_button_bg"
                    android:focusable="true"
                    android:clickable="true"
                    android:contentDescription="@string/play_pause" />

                <ImageView
                    android:id="@+id/btnNowNext"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:padding="7dp"
                    android:src="@drawable/ic_skip_next"
                    android:tint="@drawable/pill_text"
                    android:background="@drawable/media_button_bg"
                    android:focusable="true"
                    android:clickable="true"
                    android:contentDescription="@string/next" />

            </LinearLayout>
        </RelativeLayout>

        <!-- The wrapper clips at the grid's edge; the grid itself must not clip so scaled tiles can overflow their cells. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>

    <!-- The single floating glass highlight that springs between tiles. -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>
