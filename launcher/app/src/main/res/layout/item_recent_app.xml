<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:layout_marginEnd="14dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- The App Card -->
    <LinearLayout
        android:id="@+id/recentCard"
        android:layout_width="128dp"
        android:layout_height="104dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp"
        android:focusable="true"
        android:clickable="true"
        android:background="@drawable/recent_app_card_bg"
        android:clipChildren="false">

        <ImageView
            android:id="@+id/recentIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:scaleType="fitCenter"
            android:layout_marginBottom="6dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/recentLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:fontFamily="@string/font_medium" />

        <TextView
            android:id="@+id/recentTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#99FFFFFF"
            android:textSize="10sp"
            android:layout_marginTop="2dp"
            android:fontFamily="@string/font_regular" />
    </LinearLayout>

    <!-- Close Button directly below the Card -->
    <TextView
        android:id="@+id/recentBtnClose"
        android:layout_width="88dp"
        android:layout_height="28dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:focusable="true"
        android:clickable="true"
        android:background="@drawable/recent_close_pill_bg"
        android:textColor="@color/recent_close_pill_text"
        android:textSize="11.5sp"
        android:fontFamily="@string/font_medium"
        android:text="@string/close_pill"
        android:drawableStart="@drawable/ic_close_small"
        android:drawableTint="@color/recent_close_pill_text"
        android:drawablePadding="5dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp" />
</LinearLayout>
