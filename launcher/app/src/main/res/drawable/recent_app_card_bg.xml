<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#75FFFFFF"
                android:endColor="#55FFFFFF" />
            <stroke
                android:width="2dp"
                android:color="#FFFFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#3E24242C"
                android:centerColor="#2C1A1A22"
                android:endColor="#1E121216" />
            <stroke
                android:width="1dp"
                android:color="#35FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
